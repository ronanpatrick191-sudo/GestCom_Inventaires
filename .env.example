# ── Base de données MySQL ──
# URL complète : mysql+pymysql://utilisateur:motdepasse@hote/nombase
DATABASE_URL=mysql+pymysql://root:motdepasse_local@localhost/gestcom_db

# ── Accès à l'application (protection niveau A) ──
# Identifiant + mot de passe UNIQUES, partagés par toutes les personnes
# autorisées. OBLIGATOIRE en production : sans ACCES_MOTDEPASSE, l'application
# est ouverte à tout le monde. Choisis un mot de passe long et aléatoire.
ACCES_UTILISATEUR=gestcom
ACCES_MOTDEPASSE=change-moi-mot-de-passe-long-et-aleatoire

SMTP_USER=ton.email@gmail.com
SMTP_PASSWORD=ton_mot_de_passe_application_gmail
SMTP_DEST=gerant@boutique.cm

# Paiements mobiles — laisser vide tant que les accès marchand ne sont pas
# obtenus : la caisse reste alors en mode démo (QR + confirmation manuelle).
ORANGE_MONEY_API_KEY=
ORANGE_MONEY_MERCHANT_ID=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=
